{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Keeping your distro logo on the left. Set to "none" if you want text-only.
    "type": "auto"
  },
  "display": {
    "separator": " => ",
    "constants": [
      "┌─────────────────────────────────────────────────┐",
      "└─────────────────────────────────────────────────┘",
      "│"
    ]
  },
  "modules": [
    // --- Header ---
    {
      "type": "custom",
      "format": "{$1}" // Uses the first constant (Top border)
    },
    "title",
    {
      "type": "custom",
      "format": "{$2}" // Uses the second constant (Bottom border)
    },
    {
      "type": "colors",
      "symbol": "circle" // Replicates your custom  dots natively
    },
    {
      "type": "custom",
      "format": "{$1}"
    },

    // --- OS Block ---
    {
      "type": "os",
      "key": " OS",
      "keyColor": "blue" // Adjust colors to match your old $c1, $c2, etc.
    },
    {
      "type": "host", // Replaces Neofetch 'distro' to prevent duplicate OS printing
      "key": "│ ├  ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "│ ├  ",
      "keyColor": "blue",
      "format": "{1} {2}" // Turns off shorthand (shows full kernel string)
    },
    {
      "type": "packages",
      "key": "│ ├ 󰏗 ",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "│ └  ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "{$3}" // Empty connecting line
    },

    // --- DE/WM Block ---
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "magenta"
    },
    {
      "type": "theme",
      "key": "│ ├  ",
      "keyColor": "magenta"
    },
    {
      "type": "icons",
      "key": "│ ├  ",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "│ └  ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "{$3}" 
    },

    // --- PC Block ---
    {
      "type": "chassis", // Used to replicate 'model'
      "key": " PC",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "│ ├ 󰍛 ",
      "keyColor": "cyan",
      "temp": true // Replicates cpu_temp="C"
    },
    {
      "type": "cpuusage",
      "key": "│ ├ 󰍛 ",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "│ ├ 󰍹 ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "│ ├  ",
      "keyColor": "cyan" // Memory is output in GiB by default in fastfetch
    },
    {
      "type": "uptime",
      "key": "│ ├ 󰥔 ",
      "keyColor": "cyan"
    },
    
    // --- Footer ---
    {
      "type": "custom",
      "format": "{$2}"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
